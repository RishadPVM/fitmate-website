---
export interface Props {
  name:
    | 'logo'
    | 'connect'
    | 'consistency'
    | 'insights'
    | 'organized'
    | 'info'
    | 'attendance'
    | 'membership'
    | 'habits'
    | 'body'
    | 'progress'
    | 'gym'
    | 'arrow-right'
    | 'chevron-down'
    | 'check'
    | 'clock'
    | 'sparkles'
    | 'shield'
    | 'apple'
    | 'play-store'
    | 'instagram'
    | 'x'
    | 'linkedin'
    | 'youtube'
    | 'menu'
    | 'close';
  size?: number;
  class?: string;
}

const { name, size = 24, class: className = '' } = Astro.props;
---

{name === 'logo' && (
  <svg
    width={size}
    height={size}
    viewBox="0 0 36 36"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class={className}
    aria-hidden="true"
  >
    <rect width="36" height="36" rx="10" fill="#11151D" />
    <rect x="0.75" y="0.75" width="34.5" height="34.5" rx="9.25" stroke="url(#fm-border)" stroke-width="1.5" />
    <path
      d="M9 12.5C9 10.8431 10.3431 9.5 12 9.5H24.5"
      stroke="#FFFFFF"
      stroke-width="2.4"
      stroke-linecap="round"
    />
    <path
      d="M9 12.5V26.5"
      stroke="#FFFFFF"
      stroke-width="2.4"
      stroke-linecap="round"
    />
    <path
      d="M9.2 18.2H18.5L21.5 14.4L24.5 22L27 18.2"
      stroke="url(#fm-pulse)"
      stroke-width="2.3"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <defs>
      <linearGradient id="fm-border" x1="2" y1="2" x2="34" y2="34" gradientUnits="userSpaceOnUse">
        <stop stop-color="#A3C0FF" stop-opacity="0.55" />
        <stop offset="1" stop-color="#789CEB" stop-opacity="0.12" />
      </linearGradient>
      <linearGradient id="fm-pulse" x1="9" y1="18" x2="27" y2="18" gradientUnits="userSpaceOnUse">
        <stop stop-color="#A3C0FF" />
        <stop offset="1" stop-color="#789CEB" />
      </linearGradient>
    </defs>
  </svg>
)}

{name === 'connect' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
  </svg>
)}

{name === 'consistency' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
    <path d="M12 2v4" />
    <path d="m16.24 7.76 2.83-2.83" />
    <path d="M20 12h4" opacity="0" />
    <circle cx="12" cy="13" r="8" />
    <path d="M12 9v4l2.5 2.5" />
  </svg>
)}

{name === 'insights' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
    <path d="M3 3v18h18" />
    <path d="m19 9-5 5-4-4-3 3" />
  </svg>
)}

{name === 'organized' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
    <rect x="3" y="3" width="7" height="7" rx="1.5" />
    <rect x="14" y="3" width="7" height="7" rx="1.5" />
    <rect x="14" y="14" width="7" height="7" rx="1.5" />
    <rect x="3" y="14" width="7" height="7" rx="1.5" />
  </svg>
)}

{name === 'info' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
    <circle cx="12" cy="12" r="9" />
    <path d="M12 16v-4" />
    <path d="M12 8h.01" />
  </svg>
)}

{name === 'attendance' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
    <rect x="3" y="4" width="18" height="18" rx="2.5" />
    <path d="M16 2v4" />
    <path d="M8 2v4" />
    <path d="M3 10h18" />
    <path d="m9 16 2 2 4-4" />
  </svg>
)}

{name === 'membership' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
