---
import Icons from './Icons.astro';

const memberPoints = [
  'Stay connected with your gym.',
  'View membership-related information.',
  'Track attendance.',
  'Explore personal health insights.',
  'Maintain consistency.',
];

const gymPoints = [
  'A more organized member experience.',
  'Better member connectivity.',
  'A modern digital experience.',
  'Simplified gym management.',
];
---

<section id="better-experience" class="section section--alt experience-section" aria-labelledby="experience-heading">
  <div class="container">
    <div class="section-header section-header--center" data-reveal>
      <span class="eyebrow">05 · Connected Ecosystem</span>
      <h2 id="experience-heading" class="display-title">Your Gym Experience, Connected.</h2>
      <p class="lead">
        FitMate bridges daily member consistency and organized club operations inside one unified, modern experience.
      </p>
    </div>

    <!-- Architectural Connection Bridge Visual -->
    <div class="surface-card experience-bridge" data-reveal>
      <div class="bridge-node">
        <span class="bridge-node__icon" aria-hidden="true">
          <Icons name="habits" size={20} />
        </span>
        <div>
          <strong class="bridge-node__title">Gym Members</strong>
          <span class="bridge-node__sub">Free daily companion</span>
        </div>
      </div>

      <div class="bridge-line" aria-hidden="true">
        <span class="bridge-line__track"></span>
        <span class="bridge-line__core">
          <Icons name="logo" size={32} />
          <span>FitMate</span>
        </span>
      </div>

      <div class="bridge-node bridge-node--right">
        <span class="bridge-node__icon" aria-hidden="true">
          <Icons name="gym" size={20} />
        </span>
        <div>
          <strong class="bridge-node__title">Fitness Clubs</strong>
          <span class="bridge-node__sub">Organized member platform</span>
        </div>
      </div>
    </div>

    <div class="experience-columns">
      <article class="surface-card exp-card exp-card--members" data-reveal>
        <div class="exp-card__head">
          <span class="exp-card__badge">For Members</span>
          <span class="exp-card__icon" aria-hidden="true">
            <Icons name="habits" size={21} />
          </span>
        </div>
        <h3 class="exp-card__title">A Clearer Personal Companion</h3>
        <p class="exp-card__sub">
          Everything you need to stay engaged with your routine and informed about your gym connection—completely free.
        </p>
        <ul class="exp-list">
          {memberPoints.map((point) => (
            <li class="exp-list__item">
              <span class="exp-list__dot" aria-hidden="true"></span>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      </article>

      <article class="surface-card exp-card exp-card--gyms" data-reveal style="--reveal-delay: 120ms">
        <div class="exp-card__head">
          <span class="exp-card__badge exp-card__badge--gym">For Gyms</span>
          <span class="exp-card__icon" aria-hidden="true">
            <Icons name="gym" size={21} />
          </span>
        </div>
        <h3 class="exp-card__title">A Smarter Modern Club Standard</h3>
        <p class="exp-card__sub">
          Deliver an elevated, well-organized fitness club experience that helps members feel connected from day one.
        </p>
        <ul class="exp-list">
          {gymPoints.map((point) => (
            <li class="exp-list__item">
              <span class="exp-list__dot" aria-hidden="true"></span>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      </article>
    </div>
  </div>
</section>

<style>
  .experience-bridge {
    margin-top: clamp(2.25rem, 4vw, 3.25rem);
    margin-bottom: 1.5rem;
    padding: clamp(1.35rem, 3vw, 2rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    align-items: center;
    background: linear-gradient(135deg, rgba(23, 28, 39, 0.85), rgba(11, 15, 22, 0.94));
    border-color: rgba(163, 192, 255, 0.16);
  }

  @media (min-width: 768px) {
    .experience-bridge {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 2rem;
    }
  }

  .bridge-node {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.85rem 1.1rem;
    border-radius: 1rem;
    background: rgba(9, 11, 16, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .bridge-node__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.8rem;
    background: rgba(163, 192, 255, 0.13);
    color: var(--accent-primary);
    flex-shrink: 0;
  }

  .bridge-node__title {
    display: block;
    font-family: var(--font-display);
    font-size: 0.98rem;
    color: var(--text-primary);
  }

  .bridge-node__sub {
    display: block;
    font-size: 0.78rem;
    color: var(--text-subtle);
  }

  .bridge-line {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
  }

  .bridge-line__track {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, rgba(163, 192, 255, 0.15), rgba(163, 192, 255, 0.75), rgba(163, 192, 255, 0.15));
  }

  .bridge-line__core {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 1rem;
    border-radius: var(--radius-pill);
    background: #0d121c;
    border: 1px solid rgba(163, 192, 255, 0.35);
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-primary);
    box-shadow: 0 8px 25px rgba(120, 156, 235, 0.22);
  }

  .experience-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .experience-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .exp-card {
    padding: clamp(1.65rem, 3vw, 2.35rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .exp-card--members {
    border-color: rgba(163, 192, 255, 0.18);
  }

  .exp-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .exp-card__badge {
    padding: 0.3rem 0.78rem;
    border-radius: var(--radius-pill);
    background: rgba(163, 192, 255, 0.14);
    border: 1px solid rgba(163, 192, 255, 0.3);
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-primary);
  }

  .exp-card__badge--gym {
    background: rgba(120, 156, 235, 0.12);
    border-color: rgba(120, 156, 235, 0.3);
  }

  .exp-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.8rem;
    background: rgba(255, 255, 255, 0.05);
    color: var(--accent-primary);
  }

  .exp-card__title {
    font-size: 1.38rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .exp-card__sub {
    font-size: 0.94rem;
    line-height: 1.6;
  }

  .exp-list {
    display: flex;
    flex-direction: column;
    gap: 0.78rem;
    margin-top: 0.4rem;
    padding-top: 1.1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }

  .exp-list__item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-size: 0.97rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .exp-list__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent-primary);
    box-shadow: 0 0 10px rgba(163, 192, 255, 0.55);
    flex-shrink: 0;
  }
</style>
