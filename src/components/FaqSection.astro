---
import { FAQS } from '../config/site';
import Icons from './Icons.astro';
---

<section id="faq" class="section faq-section" aria-labelledby="faq-heading">
  <div class="container container--narrow">
    <div class="section-header section-header--center" data-reveal>
      <span class="eyebrow">09 · Questions &amp; Clarity</span>
      <h2 id="faq-heading" class="display-title">Frequently Asked Questions</h2>
      <p class="lead">
        Clear answers about how FitMate works for gym members and fitness clubs.
      </p>
    </div>

    <div class="faq-list" data-faq-accordion>
      {FAQS.map((item, idx) => (
        <article class={`surface-card faq-item ${idx === 0 ? 'is-open' : ''}`} data-reveal style={`--reveal-delay: ${(idx % 5) * 45}ms`}>
          <h3 class="faq-item__heading">
            <button
              type="button"
              class="faq-trigger"
              id={`faq-btn-${idx}`}
              aria-expanded={idx === 0 ? 'true' : 'false'}
              aria-controls={`faq-panel-${idx}`}
              data-faq-trigger
            >
              <span class="faq-trigger__index tabular-nums">{String(idx + 1).padStart(2, '0')}</span>
              <span class="faq-trigger__question">{item.question}</span>
              <span class="faq-trigger__icon" aria-hidden="true">
                <Icons name="chevron-down" size={20} />
              </span>
            </button>
          </h3>

          <div
            id={`faq-panel-${idx}`}
            role="region"
            aria-labelledby={`faq-btn-${idx}`}
            class="faq-panel"
          >
            <div class="faq-panel__inner">
              <p class="faq-panel__answer">{item.answer}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-list {
    margin-top: clamp(2.25rem, 4.5vw, 3.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .faq-item {
    border-radius: 1.1rem;
    overflow: hidden;
  }

  .faq-item.is-open {
    border-color: rgba(163, 192, 255, 0.32);
    background: linear-gradient(155deg, rgba(29, 36, 51, 0.88), rgba(17, 21, 29, 0.96));
  }

  .faq-item__heading {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
  }

  .faq-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.2rem 1.35rem;
    background: transparent;
    border: none;
    text-align: left;
    cursor: pointer;
    color: var(--text-primary);
  }

  .faq-trigger__index {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent-primary);
    flex-shrink: 0;
  }

  .faq-trigger__question {
    flex: 1;
    font-family: var(--font-display);
    font-size: clamp(0.98rem, 0.94rem + 0.25vw, 1.1rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.35;
  }

  .faq-trigger__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    color: var(--accent-primary);
    flex-shrink: 0;
    transition: transform 0.35s var(--ease-editorial), background-color 0.25s ease;
  }

  .faq-item.is-open .faq-trigger__icon {
    transform: rotate(180deg);
    background: rgba(163, 192, 255, 0.16);
  }

  .faq-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s var(--ease-editorial);
  }

  .faq-item.is-open .faq-panel {
    grid-template-rows: 1fr;
  }

  .faq-panel__inner {
    overflow: hidden;
  }

  .faq-panel__answer {
    padding: 0 1.35rem 1.35rem 3.35rem;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  @media (max-width: 480px) {
    .faq-trigger {
      padding: 1rem;
      gap: 0.75rem;
    }

    .faq-panel__answer {
      padding: 0 1rem 1.15rem 1rem;
    }
  }
</style>
