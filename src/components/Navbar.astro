---
import { SITE } from '../config/site';
import Icons from './Icons.astro';

export interface Props {
  isHome?: boolean;
}

const { isHome = true } = Astro.props;
const linkPrefix = isHome ? '' : '/';
---

<header class="site-header" id="site-header">
  <div class="container site-header__inner">
    <a href={isHome ? '#hero' : '/'} class="brand-lockup" aria-label="FitMate Home">
      <Icons name="logo" size={34} />
      <span class="brand-lockup__name">{SITE.brandName}</span>
    </a>

    <nav class="site-nav" aria-label="Primary navigation">
      <ul class="site-nav__list">
        {SITE.navLinks.map((link) => (
          <li>
            <a
              href={`${linkPrefix}${link.href}`}
              class="site-nav__link"
              data-nav-section={link.sectionId}
            >
              {link.label}
              <span class="site-nav__indicator" aria-hidden="true"></span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href={`${linkPrefix}#download`} class="btn btn--primary btn--compact site-header__cta">
        Download App
      </a>
      <button
        type="button"
        class="mobile-menu-toggle"
        id="mobile-menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-drawer"
        aria-label="Open navigation menu"
      >
        <Icons name="menu" size={22} class="mobile-menu-toggle__open" />
        <Icons name="close" size={22} class="mobile-menu-toggle__close" />
      </button>
    </div>
  </div>
</header>

<div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
  <div class="mobile-drawer__backdrop" data-close-drawer></div>
  <div class="mobile-drawer__panel" role="dialog" aria-modal="true" aria-label="Mobile Navigation">
    <div class="mobile-drawer__top">
      <a href={isHome ? '#hero' : '/'} class="brand-lockup" data-close-drawer>
        <Icons name="logo" size={30} />
        <span class="brand-lockup__name">{SITE.brandName}</span>
      </a>
      <button
        type="button"
        class="mobile-drawer__close"
        data-close-drawer
        aria-label="Close navigation menu"
      >
        <Icons name="close" size={22} />
      </button>
    </div>

    <nav class="mobile-drawer__nav" aria-label="Mobile primary links">
      <ul>
        {SITE.navLinks.map((link, index) => (
          <li style={`--drawer-delay: ${index * 45}ms`}>
            <a
              href={`${linkPrefix}${link.href}`}
              class="mobile-drawer__link"
              data-nav-section={link.sectionId}
              data-close-drawer
            >
              <span class="mobile-drawer__index">0{index + 1}</span>
              <span>{link.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mobile-drawer__footer">
      <a href={`${linkPrefix}#download`} class="btn btn--primary mobile-drawer__cta" data-close-drawer>
        Download App
        <Icons name="arrow-right" size={16} />
      </a>
      <p class="mobile-drawer__tagline">{SITE.tagline}</p>
    </div>
  </div>
</div>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: var(--nav-height);
    display: flex;
    align-items: center;
    background: linear-gradient(180deg, rgba(9, 11, 16, 0.72) 0%, rgba(9, 11, 16, 0) 100%);
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.4s var(--ease-editorial),
      backdrop-filter 0.4s var(--ease-editorial),
      border-color 0.4s ease,
      box-shadow 0.4s ease;
  }

  .site-header.is-scrolled {
    background: rgba(9, 11, 16, 0.82);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    border-bottom-color: rgba(163, 192, 255, 0.12);
    box-shadow: 0 12px 40px -18px rgba(0, 0, 0, 0.8);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .brand-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .brand-lockup__name {
    font-family: var(--font-display);
    font-size: 1.22rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .site-nav {
    display: none;
  }

  @media (min-width: 1024px) {
    .site-nav {
      display: block;
    }
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.45rem;
    border-radius: var(--radius-pill);
    background: rgba(17, 21, 29, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .site-nav__link {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    padding: 0.45rem 0.65rem;
    border-radius: var(--radius-pill);
    font-size: 0.81rem;
    font-weight: 500;
    color: var(--text-secondary);
    white-space: nowrap;
    transition: color 0.25s ease, background-color 0.25s ease;
  }

  @media (min-width: 1200px) {
    .site-nav__link {
      padding: 0.48rem 0.9rem;
      font-size: 0.84rem;
    }
  }

  .site-nav__link:hover {
    color: var(--text-primary);
    background-color: rgba(255, 255, 255, 0.04);
  }

  .site-nav__link.is-active {
    color: var(--text-primary);
    background-color: rgba(163, 192, 255, 0.11);
  }

  .site-nav__indicator {
    position: absolute;
    bottom: 0.22rem;
    width: 1rem;
    height: 2px;
    border-radius: 99px;
    background: var(--accent-primary);
    transform: scaleX(0);
    opacity: 0;
    transition: transform 0.3s var(--ease-editorial), opacity 0.25s ease;
  }

  .site-nav__link.is-active .site-nav__indicator {
    transform: scaleX(1);
    opacity: 1;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .site-header__cta {
    display: none;
  }

  @media (min-width: 480px) {
    .site-header__cta {
      display: inline-flex;
    }
  }

  .mobile-menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.65rem;
    height: 2.65rem;
    border-radius: 50%;
    background: rgba(23, 28, 39, 0.75);
    border: 1px solid rgba(163, 192, 255, 0.16);
    color: var(--text-primary);
    cursor: pointer;
    transition: border-color 0.25s ease, background-color 0.25s ease;
  }

  .mobile-menu-toggle:hover {
    border-color: var(--accent-primary);
  }

  .mobile-menu-toggle__close {
    display: none;
  }

  .mobile-menu-toggle[aria-expanded='true'] .mobile-menu-toggle__open {
    display: none;
  }

  .mobile-menu-toggle[aria-expanded='true'] .mobile-menu-toggle__close {
    display: block;
  }

  @media (min-width: 1024px) {
    .mobile-menu-toggle {
      display: none;
    }
  }

  /* Mobile Drawer */
  .mobile-drawer {
    position: fixed;
    inset: 0;
    z-index: 200;
    pointer-events: none;
    visibility: hidden;
  }

  .mobile-drawer.is-open {
    pointer-events: auto;
    visibility: visible;
  }

  .mobile-drawer__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(5, 7, 11, 0.76);
    backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .mobile-drawer.is-open .mobile-drawer__backdrop {
    opacity: 1;
  }

  .mobile-drawer__panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(100vw, 24rem);
    padding: 1.5rem;
    background: linear-gradient(180deg, #11151d 0%, #090b10 100%);
    border-left: 1px solid rgba(163, 192, 255, 0.14);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transform: translateX(100%);
    transition: transform 0.42s var(--ease-editorial);
    overflow-y: auto;
  }

  .mobile-drawer.is-open .mobile-drawer__panel {
    transform: translateX(0);
  }

  .mobile-drawer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .mobile-drawer__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: rgba(23, 28, 39, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-primary);
    cursor: pointer;
  }

  .mobile-drawer__nav {
    margin-block: 1.5rem auto;
  }

  .mobile-drawer__nav li {
    opacity: 0;
    transform: translateX(18px);
    transition: opacity 0.38s ease, transform 0.42s var(--ease-editorial);
    transition-delay: var(--drawer-delay, 0ms);
  }

  .mobile-drawer.is-open .mobile-drawer__nav li {
    opacity: 1;
    transform: translateX(0);
  }

  .mobile-drawer__link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.95rem 0.75rem;
    border-radius: 0.85rem;
    font-family: var(--font-display);
    font-size: 1.18rem;
    font-weight: 600;
    color: var(--text-secondary);
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .mobile-drawer__link:hover,
  .mobile-drawer__link.is-active {
    color: var(--text-primary);
    background: rgba(163, 192, 255, 0.09);
  }

  .mobile-drawer__index {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-primary);
    font-variant-numeric: tabular-nums;
  }

  .mobile-drawer__footer {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .mobile-drawer__cta {
    width: 100%;
  }

  .mobile-drawer__tagline {
    text-align: center;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
</style>
