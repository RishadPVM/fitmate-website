---
import { BMI_CATEGORIES } from '../config/site';
import Icons from './Icons.astro';
---

<section id="health-bmi" class="section section--alt bmi-section" aria-labelledby="bmi-heading">
  <div class="ambient-glow bmi-section__glow" aria-hidden="true"></div>

  <div class="container">
    <div class="bmi-section__intro">
      <div class="section-header" data-reveal>
        <span class="eyebrow">04 · Health &amp; BMI Insights</span>
        <h2 id="bmi-heading" class="display-title">Understand Your Body. Improve Your Journey.</h2>
        <p class="lead">
          Your fitness journey becomes more meaningful when you understand your body. FitMate helps you explore
          important health measurements and build better awareness of your progress.
        </p>
      </div>

      <div class="bmi-formula-card surface-card" data-reveal style="--reveal-delay: 120ms">
        <span class="bmi-formula-card__label">How BMI Is Calculated</span>
        <div class="bmi-formula-card__equation" aria-label="BMI equals Weight in kilograms divided by Height in meters squared">
          <span>BMI</span>
          <span class="eq-op">=</span>
          <span class="eq-fraction">
            <span>Weight (kg)</span>
            <span class="eq-bar" aria-hidden="true"></span>
            <span>Height (m)²</span>
          </span>
        </div>
      </div>
    </div>

    <div class="bmi-grid">
      <!-- Interactive BMI Calculator -->
      <div class="surface-card bmi-calculator" data-reveal id="bmi-calculator">
        <div class="bmi-calculator__top">
          <div>
            <span class="bmi-calculator__kicker">Interactive Health Tool</span>
            <h3 class="bmi-calculator__title">Explore Your BMI</h3>
          </div>
          <button type="button" class="bmi-reset-btn" id="bmi-reset-btn">Reset Default</button>
        </div>

        <div class="bmi-inputs">
          <div class="bmi-field">
            <div class="bmi-field__head">
              <label for="bmi-height-input" class="bmi-field__label">Height (cm)</label>
              <div class="bmi-field__num-wrap">
                <input
                  id="bmi-height-input"
                  type="number"
                  inputmode="decimal"
                  min="100"
                  max="250"
                  step="1"
                  value="175"
                  class="bmi-num-input tabular-nums"
                  aria-describedby="bmi-height-help"
                />
                <span class="bmi-unit">cm</span>
              </div>
            </div>
            <input
              id="bmi-height-range"
              type="range"
              min="100"
              max="250"
              step="1"
              value="175"
              class="bmi-range"
              aria-label="Height slider in centimeters"
            />
            <span id="bmi-height-help" class="bmi-field__bounds tabular-nums">
              <span>100 cm</span>
              <span>250 cm</span>
            </span>
          </div>

          <div class="bmi-field">
            <div class="bmi-field__head">
              <label for="bmi-weight-input" class="bmi-field__label">Weight (kg)</label>
              <div class="bmi-field__num-wrap">
                <input
                  id="bmi-weight-input"
                  type="number"
                  inputmode="decimal"
                  min="30"
                  max="250"
                  step="0.5"
                  value="70"
                  class="bmi-num-input tabular-nums"
                  aria-describedby="bmi-weight-help"
                />
                <span class="bmi-unit">kg</span>
              </div>
            </div>
            <input
              id="bmi-weight-range"
              type="range"
              min="30"
              max="250"
              step="0.5"
              value="70"
              class="bmi-range"
              aria-label="Weight slider in kilograms"
            />
            <span id="bmi-weight-help" class="bmi-field__bounds tabular-nums">
              <span>30 kg</span>
              <span>250 kg</span>
            </span>
          </div>
        </div>

        <p class="bmi-error" id="bmi-error" role="alert" hidden></p>

        <!-- Result & Animated Scale -->
        <div class="bmi-result" aria-live="polite" aria-atomic="true">
          <div class="bmi-result__metrics">
            <div>
              <span class="bmi-result__caption">Calculated BMI</span>
              <strong class="bmi-result__value tabular-nums" id="bmi-value">22.9</strong>
            </div>
            <span class="bmi-category-pill" id="bmi-category-pill" data-category="normal">
              Normal range
            </span>
          </div>

          <p class="bmi-result__summary" id="bmi-summary">
            A BMI between 18.5 and 24.9 falls within the standard adult normal screening range.
          </p>

          <div class="bmi-scale" aria-label="Visual BMI reference scale from Underweight to Obesity">
            <div class="bmi-scale__track">
              <span class="bmi-seg bmi-seg--under"></span>
              <span class="bmi-seg bmi-seg--normal"></span>
              <span class="bmi-seg bmi-seg--over"></span>
              <span class="bmi-seg bmi-seg--obese"></span>
              <div class="bmi-scale__marker" id="bmi-scale-marker" style="left: 23%">
                <span class="bmi-scale__marker-dot"></span>
              </div>
            </div>
            <div class="bmi-scale__ticks tabular-nums">
              <span>15</span>
              <span>18.5</span>
              <span>25</span>
              <span>30</span>
              <span>40+</span>
            </div>
          </div>
        </div>

        <!-- Educational Disclaimer inside calculator -->
        <div class="bmi-disclaimer" role="note">
          <Icons name="info" size={18} class="bmi-disclaimer__icon" />
          <p>
            <strong>Important Health Context:</strong> BMI is a screening indicator, not a complete measure of health or
            a medical diagnosis. BMI does not directly measure body fat, and individual interpretation may vary.
          </p>
        </div>
      </div>

      <!-- Educational Guide + Reference Categories -->
      <div class="bmi-education">
        <div class="bmi-guide-cards">
          <article class="surface-card bmi-guide-card" data-reveal style="--reveal-delay: 80ms">
            <h3 class="bmi-guide-card__title">What Is BMI &amp; Why It Matters</h3>
            <p class="bmi-guide-card__text">
              Body Mass Index (BMI) compares body weight against height squared as an accessible screening baseline.
              Understanding how it works empowers calmer, more informed awareness of body trends over time.
            </p>
          </article>

          <article class="surface-card bmi-guide-card" data-reveal style="--reveal-delay: 140ms">
            <h3 class="bmi-guide-card__title">Monitoring Changes &amp; Healthier Habits</h3>
            <p class="bmi-guide-card__text">
              Pairing periodic measurement check-ins with consistent training and recovery helps shift focus toward
              steady, sustainable fitness habits rather than overnight changes.
            </p>
          </article>
        </div>

        <div class="surface-card bmi-categories-card" data-reveal style="--reveal-delay: 200ms">
          <div class="bmi-categories-header">
            <div>
              <h3 class="bmi-categories-card__title">Standard Adult BMI Categories</h3>
              <p class="bmi-categories-card__sub">General educational reference ranges for adults:</p>
            </div>
            <span class="bmi-categories-badge" aria-hidden="true">
              <Icons name="body" size={18} />
            </span>
          </div>

          <ul class="bmi-categories-list">
            {BMI_CATEGORIES.map((cat) => (
              <li class="bmi-cat-row" data-bmi-row={cat.key}>
                <span class="bmi-cat-row__left">
                  <span class="bmi-cat-row__swatch" style={`background: ${cat.colorVar}`}></span>
                  <span class="bmi-cat-row__name">{cat.label}</span>
                </span>
                <span class="bmi-cat-row__range tabular-nums">{cat.range}</span>
              </li>
            ))}
          </ul>

          <p class="bmi-categories-footnote">
            Note: Factors such as muscle mass, bone density, age, and sex are not separated by BMI alone.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .bmi-section {
    overflow: hidden;
  }

  .bmi-section__glow {
    left: -12rem;
    bottom: -8rem;
    width: 34rem;
    height: 34rem;
    background: radial-gradient(circle, rgba(120, 156, 235, 0.14), transparent 70%);
  }

  .bmi-section__intro {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    margin-bottom: clamp(2.5rem, 4.5vw, 3.75rem);
  }

  @media (min-width: 960px) {
    .bmi-section__intro {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  .bmi-formula-card {
    padding: 1.25rem 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    flex-shrink: 0;
  }

  .bmi-formula-card__label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-primary);
  }

  .bmi-formula-card__equation {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .eq-op {
    color: var(--accent-primary);
  }

  .eq-fraction {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    font-size: 0.88rem;
    line-height: 1.3;
  }

  .eq-bar {
    width: 100%;
    height: 1px;
    margin-block: 0.2rem;
    background: rgba(163, 192, 255, 0.45);
  }

  .bmi-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: stretch;
  }

  @media (min-width: 1024px) {
    .bmi-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }
  }

  .bmi-calculator {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .bmi-calculator__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .bmi-calculator__kicker {
    display: block;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-primary);
    margin-bottom: 0.35rem;
  }

  .bmi-calculator__title {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .bmi-reset-btn {
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text-secondary);
    cursor: pointer;
    transition: border-color 0.25s ease, color 0.25s ease;
  }

  .bmi-reset-btn:hover {
    border-color: var(--accent-primary);
    color: var(--text-primary);
  }

  .bmi-inputs {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 560px) {
    .bmi-inputs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .bmi-field {
    padding: 1rem 1.1rem;
    border-radius: 1rem;
    background: rgba(9, 11, 16, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.07);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .bmi-field__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .bmi-field__label {
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .bmi-field__num-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.65rem;
    border-radius: 0.6rem;
    background: rgba(23, 28, 39, 0.9);
    border: 1px solid rgba(163, 192, 255, 0.2);
  }

  .bmi-num-input {
    width: 3.6rem;
    background: transparent;
    border: none;
    text-align: right;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    color: var(--text-primary);
  }

  .bmi-num-input:focus {
    outline: none;
  }

  .bmi-field__num-wrap:focus-within {
    border-color: var(--accent-primary);
    box-shadow: 0 0 0 2px rgba(163, 192, 255, 0.18);
  }

  .bmi-unit {
    font-size: 0.78rem;
    color: var(--text-subtle);
  }

  .bmi-range {
    width: 100%;
    height: 6px;
    border-radius: 999px;
    appearance: none;
    -webkit-appearance: none;
    background: rgba(163, 192, 255, 0.18);
    cursor: pointer;
  }

  .bmi-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--accent-primary);
    border: 2px solid #090b10;
    box-shadow: 0 0 0 3px rgba(163, 192, 255, 0.25);
    transition: transform 0.2s ease;
  }

  .bmi-range::-webkit-slider-thumb:hover {
    transform: scale(1.12);
  }

  .bmi-range::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--accent-primary);
    border: 2px solid #090b10;
  }

  .bmi-field__bounds {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    color: var(--text-subtle);
  }

  .bmi-error {
    padding: 0.7rem 0.95rem;
    border-radius: 0.75rem;
    background: rgba(251, 113, 133, 0.12);
    border: 1px solid rgba(251, 113, 133, 0.35);
    color: #fecdd3;
    font-size: 0.85rem;
  }

  .bmi-result {
    padding: 1.35rem;
    border-radius: 1.1rem;
    background: linear-gradient(155deg, rgba(163, 192, 255, 0.08), rgba(9, 11, 16, 0.72));
    border: 1px solid rgba(163, 192, 255, 0.18);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .bmi-result__metrics {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .bmi-result__caption {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
  }

  .bmi-result__value {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 2rem + 1.5vw, 3.1rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--text-primary);
  }

  .bmi-category-pill {
    padding: 0.45rem 1rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    background: rgba(94, 234, 212, 0.14);
    border: 1px solid rgba(94, 234, 212, 0.4);
    color: var(--bmi-normal);
    transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
  }

  .bmi-category-pill[data-category='underweight'] {
    background: rgba(124, 196, 255, 0.14);
    border-color: rgba(124, 196, 255, 0.42);
    color: var(--bmi-underweight);
  }

  .bmi-category-pill[data-category='overweight'] {
    background: rgba(251, 191, 36, 0.14);
    border-color: rgba(251, 191, 36, 0.42);
    color: var(--bmi-overweight);
  }

  .bmi-category-pill[data-category='obesity'] {
    background: rgba(251, 113, 133, 0.14);
    border-color: rgba(251, 113, 133, 0.42);
    color: var(--bmi-obesity);
  }

  .bmi-result__summary {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  /* Animated Scale Bar */
  .bmi-scale {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding-top: 0.35rem;
  }

  .bmi-scale__track {
    position: relative;
    height: 0.65rem;
    border-radius: 999px;
    display: grid;
    grid-template-columns: 14fr 26fr 20fr 40fr;
    gap: 2px;
    overflow: visible;
  }

  .bmi-seg {
    height: 100%;
    border-radius: 999px;
    opacity: 0.85;
  }

  .bmi-seg--under {
    background: var(--bmi-underweight);
  }

  .bmi-seg--normal {
    background: var(--bmi-normal);
  }

  .bmi-seg--over {
    background: var(--bmi-overweight);
  }

  .bmi-seg--obese {
    background: var(--bmi-obesity);
  }

  .bmi-scale__marker {
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    transition: left 0.45s var(--ease-editorial);
    pointer-events: none;
  }

  .bmi-scale__marker-dot {
    display: block;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 50%;
    background: #ffffff;
    border: 3px solid #090b10;
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.65), 0 4px 12px rgba(0, 0, 0, 0.7);
  }

  .bmi-scale__ticks {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    color: var(--text-subtle);
  }

  .bmi-disclaimer {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    padding: 0.9rem 1rem;
    border-radius: 0.85rem;
    background: rgba(9, 11, 16, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .bmi-disclaimer strong {
    color: var(--text-primary);
  }

  :global(.bmi-disclaimer__icon) {
    color: var(--accent-primary);
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  /* Right column education */
  .bmi-education {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .bmi-guide-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.15rem;
  }

  @media (min-width: 640px) {
    .bmi-guide-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .bmi-guide-card {
    padding: 1.45rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .bmi-guide-card__title {
    font-size: 1.08rem;
    font-weight: 700;
  }

  .bmi-guide-card__text {
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .bmi-categories-card {
    padding: clamp(1.35rem, 3vw, 1.85rem);
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.15rem;
  }

  .bmi-categories-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .bmi-categories-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 0.75rem;
    background: rgba(163, 192, 255, 0.12);
    color: var(--accent-primary);
    flex-shrink: 0;
  }

  .bmi-categories-card__title {
    font-size: 1.18rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .bmi-categories-card__sub {
    font-size: 0.84rem;
    color: var(--text-subtle);
  }

  .bmi-categories-list {
    display: flex;
    flex-direction: column;
    gap: 0.58rem;
  }

  .bmi-cat-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 0.95rem;
    border-radius: 0.78rem;
    background: rgba(9, 11, 16, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: border-color 0.25s ease, background-color 0.25s ease, transform 0.25s ease;
  }

  .bmi-cat-row.is-active {
    background: rgba(163, 192, 255, 0.12);
    border-color: rgba(163, 192, 255, 0.38);
    transform: translateX(3px);
  }

  .bmi-cat-row__left {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  .bmi-cat-row__swatch {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
  }

  .bmi-cat-row__name {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .bmi-cat-row__range {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .bmi-categories-footnote {
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--text-subtle);
  }
</style>
