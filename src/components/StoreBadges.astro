---
import { SITE } from '../config/site';
import Icons from './Icons.astro';

export interface Props {
  variant?: 'hero' | 'prominent' | 'compact';
  class?: string;
}

const { variant = 'prominent', class: className = '' } = Astro.props;
const { appStoreUrl, googlePlayUrl } = SITE.stores;
---

<div class={`store-badges store-badges--${variant} ${className}`}>
  {appStoreUrl ? (
    <a
      href={appStoreUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="store-badge"
      aria-label="Download FitMate on the Apple App Store"
    >
      <Icons name="apple" size={variant === 'compact' ? 20 : 24} class="store-badge__icon" />
      <span class="store-badge__copy">
        <span class="store-badge__kicker">Download on the</span>
        <span class="store-badge__name">App Store</span>
      </span>
    </a>
  ) : (
    <button
      type="button"
      class="store-badge"
      data-store-modal-trigger="ios"
      aria-label="Download FitMate on the Apple App Store"
    >
      <Icons name="apple" size={variant === 'compact' ? 20 : 24} class="store-badge__icon" />
      <span class="store-badge__copy">
        <span class="store-badge__kicker">Download on the</span>
        <span class="store-badge__name">App Store</span>
      </span>
    </button>
  )}

  {googlePlayUrl ? (
    <a
      href={googlePlayUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="store-badge"
      aria-label="Get FitMate on Google Play"
    >
      <Icons name="play-store" size={variant === 'compact' ? 20 : 24} class="store-badge__icon" />
      <span class="store-badge__copy">
        <span class="store-badge__kicker">Get it on</span>
        <span class="store-badge__name">Google Play</span>
      </span>
    </a>
  ) : (
    <button
      type="button"
      class="store-badge"
      data-store-modal-trigger="android"
      aria-label="Get FitMate on Google Play"
    >
      <Icons name="play-store" size={variant === 'compact' ? 20 : 24} class="store-badge__icon" />
      <span class="store-badge__copy">
        <span class="store-badge__kicker">Get it on</span>
        <span class="store-badge__name">Google Play</span>
      </span>
    </button>
  )}
</div>

<style>
  .store-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    align-items: center;
  }

  .store-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.72rem 1.35rem;
    min-height: 3.4rem;
    border-radius: 0.95rem;
    background: linear-gradient(155deg, rgba(29, 35, 49, 0.9), rgba(14, 18, 26, 0.96));
    border: 1px solid rgba(163, 192, 255, 0.22);
    color: var(--text-primary);
    cursor: pointer;
    text-align: left;
    transition:
      transform 0.35s var(--ease-editorial),
      border-color 0.3s ease,
      box-shadow 0.35s ease,
      background 0.3s ease;
  }

  .store-badge:hover {
    transform: translateY(-2px);
    border-color: var(--accent-primary);
    box-shadow: 0 14px 36px -12px rgba(163, 192, 255, 0.28);
  }

  .store-badges--compact .store-badge {
    min-height: 2.9rem;
    padding: 0.55rem 1rem;
    gap: 0.65rem;
    border-radius: 0.78rem;
  }

  .store-badge__icon {
    flex-shrink: 0;
    color: var(--text-primary);
  }

  .store-badge__copy {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .store-badge__kicker {
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
    text-transform: uppercase;
  }

  .store-badge__name {
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .store-badges--compact .store-badge__kicker {
    font-size: 0.6rem;
  }

  .store-badges--compact .store-badge__name {
    font-size: 0.9rem;
  }
</style>
