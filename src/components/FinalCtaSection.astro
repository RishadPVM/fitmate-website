---
import Icons from './Icons.astro';
import StoreBadges from './StoreBadges.astro';
---

<section id="final-cta" class="section section--alt final-cta" aria-labelledby="final-cta-heading">
  <div class="container">
    <div class="final-cta__card" data-reveal>
      <div class="final-cta__glow" aria-hidden="true"></div>
      <div class="final-cta__inner">
        <span class="eyebrow">A Smarter Way to Stay Fit</span>
        <h2 id="final-cta-heading" class="final-cta__title">Make Your Fitness Journey Count.</h2>
        <p class="lead final-cta__desc">
          Better habits. Better consistency. A better connection with your gym.
        </p>

        <div class="final-cta__actions">
          <a href="#download" class="btn btn--primary magnetic-btn" data-magnetic>
            Get Started With FitMate
            <Icons name="arrow-right" size={17} />
          </a>
        </div>

        <div class="final-cta__stores">
          <StoreBadges variant="compact" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta__card {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-xl);
    padding: clamp(2.75rem, 6vw, 5rem) clamp(1.5rem, 4vw, 3rem);
    background: linear-gradient(145deg, #1b2232 0%, #0d1119 65%, #090b10 100%);
    border: 1px solid rgba(163, 192, 255, 0.24);
    box-shadow: var(--shadow-card);
  }

  .final-cta__glow {
    position: absolute;
    left: 50%;
    top: -40%;
    transform: translateX(-50%);
    width: 38rem;
    height: 24rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(163, 192, 255, 0.22), transparent 68%);
    filter: blur(50px);
    pointer-events: none;
  }

  .final-cta__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.35rem;
    max-width: 40rem;
    margin-inline: auto;
  }

  .final-cta__title {
    font-size: clamp(2rem, 1.55rem + 2.4vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  .final-cta__desc {
    max-width: 32rem;
  }

  .final-cta__actions {
    padding-top: 0.25rem;
  }

  .final-cta__stores {
    padding-top: 0.35rem;
  }
</style>
