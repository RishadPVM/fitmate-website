---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icons from '../components/Icons.astro';
---

<BaseLayout
  title="Terms & Conditions | FitMate"
  description="Read the official FitMate Terms and Conditions covering free member access, educational BMI disclaimers, and gym platform guidelines."
  canonicalPath="/terms/"
  isHome={false}
  breadcrumbLabel="Terms & Conditions"
>
  <section class="legal-page">
    <div class="container container--narrow">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Terms &amp; Conditions</span>
      </nav>

      <header class="legal-header">
        <span class="eyebrow">Legal &amp; Guidelines</span>
        <h1 class="display-title">Terms &amp; Conditions</h1>
        <p class="lead">
          Clear guidelines governing the use of the official FitMate informational website and educational tools.
        </p>
      </header>

      <div class="legal-body surface-card">
        <article class="legal-block">
          <h2>1. FitMate Member Access &amp; Platform Pricing</h2>
          <p>
            FitMate is completely free for individual gym members to download and use without paying any FitMate
            subscription fee. Participating gyms pay for the FitMate platform. Individual gym memberships, class fees,
            and facility services are set and billed independently by each gym.
          </p>
        </article>

        <article class="legal-block">
          <h2>2. Health &amp; BMI Educational Disclaimer</h2>
          <p>
            Information on this website—including Body Mass Index (BMI) calculations, standard adult BMI ranges, and
            wellness guidance—is provided strictly for general informational and educational awareness. BMI is a broad
            screening indicator and does not directly measure body fat or constitute a medical diagnosis. Consult a
            qualified healthcare professional for personalized medical advice.
          </p>
        </article>

        <article class="legal-block">
          <h2>3. Illustrative Previews</h2>
          <p>
            Sample schedules, attendance streaks, and conceptual mobile interface previews shown on this website are
            illustrative demonstrations only and do not represent live customer records.
          </p>
        </article>

        <article class="legal-block">
          <h2>4. Brand Assets &amp; Intellectual Property</h2>
          <p>
            All FitMate branding, visual layouts, editorial copy, and graphics presented on this website are protected
            for official brand presentation and may not be reproduced or misrepresented without authorization.
          </p>
        </article>
      </div>

      <div class="legal-back">
        <a href="/" class="btn btn--secondary">
          <Icons name="arrow-right" size={16} class="legal-back__icon" />
          Back to FitMate Home
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-page {
    padding-top: calc(var(--nav-height) + 3.5rem);
    padding-bottom: clamp(4rem, 7vw, 6.5rem);
  }

  .breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    color: var(--text-subtle);
    margin-bottom: 1.5rem;
  }

  .breadcrumb a:hover {
    color: var(--accent-primary);
  }

  .legal-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.25rem;
  }

  .legal-body {
    padding: clamp(1.75rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .legal-block h2 {
    font-size: 1.25rem;
    margin-bottom: 0.6rem;
  }

  .legal-block p {
    font-size: 0.96rem;
    line-height: 1.7;
  }

  .legal-back {
    margin-top: 2rem;
  }

  :global(.legal-back__icon) {
    transform: rotate(180deg);
  }
</style>
